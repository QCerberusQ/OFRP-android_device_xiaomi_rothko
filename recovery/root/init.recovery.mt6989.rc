import /init.recovery.keymint.rc

on fs
    start boot-hal-1-2
    symlink /dev/block /dev/block/bootdevice
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    install_keyring
    mkdir /mnt/vendor/persist 0755 system system
    mkdir /persist 0755 system system
    mount_all /system/etc/persist.fstab --early
    restorecon_recursive /mnt/vendor/persist
    mkdir /mnt/vendor/persist/data 0755 system system
    mkdir /mnt/vendor/persist/fdsd 0755 system system
    mkdir /mnt/vendor/persist/haptics 0755 system system
    mount none /mnt/vendor/persist /persist bind
    chmod 0660 /dev/tee0
    chmod 0660 /dev/teepriv0
    chown system system /dev/tee0
    chown system system /dev/teepriv0
    chmod 0660 /dev/rpmb0
    chmod 0660 /dev/mmcblk0rpmb
    chmod 0660 /dev/0:0:0:49476
    chmod 0660 /dev/ufs-bsg0
    chmod 0666 /dev/kmsg
    chown system system /dev/rpmb0
    chown system system /dev/mmcblk0rpmb
    chown system system /dev/0:0:0:49476
    chown system system /dev/ufs-bsg0
    start mitee-helper
    setprop vendor.teefs_state ready
    setprop ro.hardware.gatekeeper mitee


service rothko-bootchain-guard /system/bin/sh /system/bin/rothko_bootchain_guard.sh init
    class core
    user root
    group root
    oneshot
    disabled
    seclabel u:r:recovery:s0

# rothko: snapuserd for userspace Virtual A/B snapshots during recovery OTA apply.
# update_engine starts it on demand (ctl.start snapuserd) when the manifest is
# VABC and ro.rothko.vabc_recovery=1; the daemon sets snapuserd.ready itself.
service snapuserd /system/bin/snapuserd
    socket snapuserd stream 0660 system system
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:recovery:s0

on post-fs
    start health-hal-2-1

on post-fs-data
    chown system system /sys/bus/i2c/drivers/awinic_haptic/0-005a/f0_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/0-005a/osc_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/0-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/0-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/0-006b/f0_save
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/0-006b/osc_save
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/0-006b/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/sih_haptic_688X/0-006b/custom_wave
    chown system system /sys/bus/i2c/drivers/awinic_haptic/0-005a/f0
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/0-005a/f0
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/f0_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/osc_save
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/1-005a/custom_wave
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/1-006b/f0_save
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/1-006b/osc_save
    chown system system /sys/bus/i2c/drivers/sih_haptic_688X/1-006b/custom_wave
    chmod 0666  /sys/bus/i2c/drivers/sih_haptic_688X/1-006b/custom_wave
    chown system system /sys/bus/i2c/drivers/awinic_haptic/1-005a/f0
    chmod 0666  /sys/bus/i2c/drivers/awinic_haptic/1-005a/f0
 
on boot
    # Xiaomi's Android touch stack uses userspace THP/raw processing. Recovery
    # has no matching daemon, so request normal kernel input events instead.
    wait /sys/devices/virtual/touch/touch_dev/enable_touch_raw 5
    write /sys/devices/virtual/touch/touch_dev/enable_touch_raw 0
    wait /dev/block/sda 10
    wait /dev/block/sdb 10
    wait /dev/block/by-name/lk_a 10
    wait /dev/block/by-name/lk_b 10
    start rothko-bootchain-guard
    setprop sys.usb.config adb

on property:twrp.modules.loaded=true
    start vendor-watchdog
    
on property:sys.vendor.watchdog=ready
    start vibratorfeature-hal-service

# Android 14 init handles sys.powerctl immediately, but queues the shutdown
# event before the built-in shutdown_done action. Prepare the BCB from that
# event so adb reboot targets and GUI reboot hooks use the same routing. The
# helper touches only the first 2048 bytes of misc and preserves A/B metadata.
on shutdown && property:sys.powerctl=reboot
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh system

on shutdown && property:sys.powerctl=reboot,
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh system

on shutdown && property:sys.powerctl=reboot,system
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh system

on shutdown && property:sys.powerctl=shutdown
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh system

on shutdown && property:sys.powerctl=shutdown,
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh system

on shutdown && property:sys.powerctl=shutdown,userrequested
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh system

on shutdown && property:sys.powerctl=reboot,recovery
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh recovery

on shutdown && property:sys.powerctl=reboot,bootloader
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh bootloader

on shutdown && property:sys.powerctl=reboot,fastboot
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh fastboot

on shutdown && property:sys.powerctl=reboot,fastbootd
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh fastbootd

on shutdown && property:sys.powerctl=reboot,sideload
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh sideload

on shutdown && property:sys.powerctl=reboot,sideload-auto-reboot
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh sideload-auto-reboot

on shutdown && property:sys.powerctl=reboot,rescue
    exec u:r:recovery:s0 root root -- /system/bin/sh /system/bin/rothko_bcb.sh rescue
