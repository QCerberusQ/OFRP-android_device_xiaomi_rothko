# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<mnt_point>         <type>             <device>                            <device2>           <mnt_flags and options>
/metadata            ext4               /dev/block/by-name/metadata                             flags=display="Metadata";backup=1
/data                f2fs               /dev/block/by-name/userdata                             flags=display="Userdata";fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/cache               ext4               /dev/block/by-name/rescue                               flags=display="Cache";wipeingui;wipeduringfactoryreset

# Additional
/mi_ext              ext4               /dev/block/mapper/mi_ext                                flags=display="MI EXT";logical
/mi_ext              erofs              /dev/block/mapper/mi_ext                                flags=display="MI EXT";logical

# Cust Partitions
/cust                ext4               /dev/block/by-name/cust                                 flags=display="cust"
/cust_image          emmc               /dev/block/by-name/cust                                 flags=display="cust_image";backup=1;flashimg=1

# Super Partitions
/super               emmc               /dev/block/by-name/super                                flags=display="Super";backup=1;flashimg=1

# Boot
/boot                emmc               /dev/block/by-name/boot                                 flags=display="boot";slotselect;backup=1;flashimg=1
/init_boot           emmc               /dev/block/by-name/init_boot                            flags=display="init_boot";slotselect;backup=1;flashimg=1
/vendor_boot         emmc               /dev/block/by-name/vendor_boot                          flags=display="vendor_boot";slotselect;backup=1;flashimg=1
/dtbo                emmc               /dev/block/by-name/dtbo                                 flags=display="dtbo";slotselect;backup=1;flashimg=1
/vbmeta              emmc               /dev/block/by-name/vbmeta                               flags=display="vbmeta";slotselect;backup=1;flashimg=1
/vbmeta_system       emmc               /dev/block/by-name/vbmeta_system                        flags=display="vbmeta_system";slotselect;backup=1;flashimg=1
/vbmeta_vendor       emmc               /dev/block/by-name/vbmeta_vendor                        flags=display="vbmeta_vendor";slotselect;backup=1;flashimg=1

# Persistent Firmware & Properties
/persist             emmc               /dev/block/by-name/persist                              flags=display="Persist";backup=1;flashimg=1

# IMEI, Bluetooth, MAC Address, Serial Number & etc Partition
/protect_f           ext4               /dev/block/by-name/protect1                             flags=display="Protect_F"
/protect_s           ext4               /dev/block/by-name/protect2                             flags=display="Protect_S"
/nvdata              ext4               /dev/block/by-name/nvdata                               flags=display="Nvdata"
/nvcfg               ext4               /dev/block/by-name/nvcfg                                flags=display="Nvcfg"
/protect_f_image     emmc               /dev/block/by-name/protect1                             flags=display="Protect_F_image";backup=1;flashimg=1
/protect_s_image     emmc               /dev/block/by-name/protect2                             flags=display="Protect_S_image";backup=1;flashimg=1
/nvdata_image        emmc               /dev/block/by-name/nvdata                               flags=display="Nvdata_image";backup=1;flashimg=1
/nvcfg_image         emmc               /dev/block/by-name/nvcfg                                flags=display="Nvcfg_image";backup=1;flashimg=1
/nvram               emmc               /dev/block/by-name/nvram                                flags=display="Nvram";backup=1;flashimg=1
/proinfo             emmc               /dev/block/by-name/proinfo                              flags=display="Proinfo";backup=1;flashimg=1
/flashinfo           emmc               /dev/block/by-name/flashinfo                            flags=display="Flashinfo";backup=1;flashimg=1
/frp                 emmc               /dev/block/by-name/frp                                  flags=display="FRP";backup=1;flashimg=1
/misc                emmc               /dev/block/by-name/misc                                 flags=display="Misc";backup=1;flashimg=1

# A/B Firmware Partitions
/apusys              emmc               /dev/block/by-name/apusys                               flags=display="apusys";slotselect;backup=1;flashimg=1
/audio_dsp           emmc               /dev/block/by-name/audio_dsp                            flags=display="audio_dsp";slotselect;backup=1;flashimg=1
/connsys_bt          emmc               /dev/block/by-name/connsys_bt                           flags=display="connsys_bt";slotselect;backup=1;flashimg=1
/connsys_wifi        emmc               /dev/block/by-name/connsys_wifi                         flags=display="connsys_wifi";slotselect;backup=1;flashimg=1
/connsys_gnss        emmc               /dev/block/by-name/connsys_gnss                         flags=display="connsys_gnss";slotselect;backup=1;flashimg=1
/countrycode         emmc               /dev/block/by-name/countrycode                          flags=display="countrycode";slotselect;backup=1;flashimg=1
/ccu                 emmc               /dev/block/by-name/ccu                                  flags=display="ccu";slotselect;backup=1;flashimg=1
/dpm                 emmc               /dev/block/by-name/dpm                                  flags=display="dpm";slotselect;backup=1;flashimg=1
/gpueb               emmc               /dev/block/by-name/gpueb                                flags=display="gpueb";slotselect;backup=1;flashimg=1
/gz                  emmc               /dev/block/by-name/gz                                   flags=display="gz";slotselect;backup=1;flashimg=1
/lk                  emmc               /dev/block/by-name/lk                                   flags=display="lk";slotselect;backup=1;flashimg=1
/logo                emmc               /dev/block/by-name/logo                                 flags=display="logo";slotselect;backup=1;flashimg=1
/mcf_ota             ext4               /dev/block/by-name/mcf_ota                              flags=display="mcf_ota";slotselect
/mcf_ota_image       emmc               /dev/block/by-name/mcf_ota                              flags=display="mcf_ota_image";slotselect;backup=1;flashimg=1
/mcupm               emmc               /dev/block/by-name/mcupm                                flags=display="mcupm";slotselect;backup=1;flashimg=1
/modem               emmc               /dev/block/by-name/modem                                flags=display="modem";slotselect;backup=1;flashimg=1
/mvpu_algo           emmc               /dev/block/by-name/mvpu_algo                            flags=display="mvpu_algo";slotselect;backup=1;flashimg=1
/pi_img              emmc               /dev/block/by-name/pi_img                               flags=display="pi_img";slotselect;backup=1;flashimg=1
/preloader_raw       emmc               /dev/block/by-name/preloader_raw                        flags=display="preloader";slotselect;backup=1;flashimg=1
/pvmfw               emmc               /dev/block/by-name/pvmfw                                flags=display="pvmfw";slotselect;backup=1;flashimg=1
/scp                 emmc               /dev/block/by-name/scp                                  flags=display="scp";slotselect;backup=1;flashimg=1
/spmfw               emmc               /dev/block/by-name/spmfw                                flags=display="spmfw";slotselect;backup=1;flashimg=1
/sspm                emmc               /dev/block/by-name/sspm                                 flags=display="sspm";slotselect;backup=1;flashimg=1
/tee                 emmc               /dev/block/by-name/tee                                  flags=display="tee";slotselect;backup=1;flashimg=1
/vcp                 emmc               /dev/block/by-name/vcp                                  flags=display="vcp";slotselect;backup=1;flashimg=1

# Removable storage
/usb_otg             auto               /dev/block/sdd1                                         flags=display="usb-otg";storage;wipeingui;removable;fsflags=utf8
